{
  "name": "jomans-vault",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "varlock": "1.23.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "@orpc/server": "^1.15.6",
      "@orpc/client": "^1.15.6",
      "@orpc/openapi": "^1.15.6",
      "@orpc/zod": "^1.15.6",
      "better-auth": "1.7.12",
      "drizzle-orm": "1.0.0-rc.5"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "bun test ./tests && turbo run test",
    "dev:web": "turbo run dev -F web --",
    "db:push": "turbo run db:push -F @jomans-vault/db --",
    "db:studio": "turbo run db:studio -F @jomans-vault/db --",
    "db:generate": "turbo run db:generate -F @jomans-vault/db --",
    "db:migrate": "turbo run db:migrate -F @jomans-vault/db --",
    "db:seed-reviewer": "turbo run db:seed-reviewer -F @jomans-vault/auth --",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose --env-file apps/web/.env build",
    "docker:up": "docker compose -f docker-compose.yml -f docker-compose.key.yml --env-file apps/web/.env up -d --build",
    "docker:up:prod": "docker compose -f docker-compose.yml -f docker-compose.key.yml -f docker-compose.prod.yml --env-file apps/web/.env up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/web && bun run auth:generate",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "build:cli": "turbo run build -F @jomans-vault/cli"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@jomans-vault/config": "workspace:*",
    "@types/node": "^26.4.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "ultracite": "8.0.0",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.4"
}
