{
  "forge": {
    "type": "github",
    "host": "github.com",
    "project": "joshuaManlunas/jomans-vault"
  },
  "concurrency": 1,
  "max_rounds": 3,
  "auto_split": false,
  "base_branch": "main",
  "merge_method": "merge",
  "review_bots": {
    "bots": [
      {
        "login": "chatgpt-codex-connector",
        "trigger": "@codex review"
      },
      {
        "login": "greptile-apps",
        "trigger": "@greptileai review"
      }
    ],
    "timeout_minutes": 20,
    "poll_seconds": 30
  },
  "labels": {
    "queue": "factory",
    "needs_info": "factory:needs-info",
    "needs_human": "factory:needs-human"
  },
  "models": {
    "fable": {
      "provider": "claudeAgent",
      "model": "claude-fable-5-2",
      "options": {
        "effort": "high"
      }
    },
    "opus": {
      "provider": "claudeAgent",
      "model": "claude-opus-5-5",
      "options": {
        "effort": "high"
      }
    },
    "sol": {
      "provider": "codex",
      "model": "gpt-6.1-sol",
      "options": {
        "reasoningEffort": "high"
      }
    },
    "daybreak-blue": {
      "provider": "codex",
      "model": "gpt-daybreak-blue-latest",
      "options": {
        "reasoningEffort": "high",
        "cyberAccessProgram": "daybreakBlue"
      }
    }
  },
  "roles": {
    "intake": "fable",
    "spec-writer": "opus",
    "builder": "sol",
    "approver": "opus"
  },
  "routing": {
    "low": {
      "code": "opus"
    },
    "medium": {
      "code": "opus"
    },
    "high": {
      "code": "opus"
    }
  },
  "surface_reviewers": {
    "ui": {
      "ux": "opus",
      "ui": "opus"
    },
    "security": {
      "security": "daybreak-blue"
    }
  },
  "protected_paths": [
    "factory/checks.sh",
    "factory/config.json"
  ],
  "ports": {
    "base": 5100,
    "step": 10
  },
  "dashboard": {
    "port": 8000,
    "open": true
  },
  "prices_usd_per_mtok": {
    "claude-fable-5-2": {
      "input": 8.0,
      "output": 40.0,
      "cache_write_5m": 10.0,
      "cache_write_1h": 16.0,
      "cache_read": 0.2
    },
    "claude-fable-5-1": {
      "input": 10.0,
      "output": 50.0,
      "cache_write_5m": 12.5,
      "cache_write_1h": 20.0,
      "cache_read": 0.25
    },
    "claude-opus-5-5": {
      "input": 4.0,
      "output": 20.0,
      "cache_write_5m": 5.0,
      "cache_write_1h": 8.0,
      "cache_read": 0.2
    },
    "claude-sonnet-5-5": {
      "input": 2.0,
      "output": 10.0,
      "cache_write_5m": 2.5,
      "cache_write_1h": 4.0,
      "cache_read": 0.1
    },
    "claude-haiku-5-5": {
      "input": 0.1,
      "output": 0.5,
      "cache_write_5m": 0.125,
      "cache_write_1h": 0.2,
      "cache_read": 0.01
    }
  }
}
