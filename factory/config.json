{
  "forge": {
    "type": "github",
    "host": "github.com",
    "project": "joshuaManlunas/jomans-vault"
  },
  "concurrency": 1,
  "max_rounds": 3,
  "auto_split": false,
  "base_branch": "main",
  "merge_method": "merge",
  "review_bots": {
    "bots": [
      {
        "login": "chatgpt-codex-connector",
        "trigger": "@codex review"
      },
      {
        "login": "greptile-apps",
        "trigger": "@greptileai review"
      }
    ],
    "timeout_minutes": 20,
    "poll_seconds": 30
  },
  "labels": {
    "queue": "factory",
    "needs_info": "factory:needs-info",
    "needs_human": "factory:needs-human"
  },
  "models": {
    "fable": {
      "provider": "claudeAgent",
      "model": "claude-fable-5-2",
      "options": {
        "effort": "high"
      }
    },
    "opus": {
      "provider": "claudeAgent",
      "model": "claude-opus-5-5",
      "options": {
        "effort": "high"
      }
    },
    "sol": {
      "provider": "codex",
      "model": "gpt-6.1-sol",
      "options": {
        "reasoningEffort": "high"
      }
    },
    "terra": {
      "provider": "codex",
      "model": "gpt-6.1-terra",
      "options": {
        "reasoningEffort": "xhigh"
      }
    },
    "daybreak-blue": {
      "provider": "codex",
      "model": "gpt-daybreak-blue-latest",
      "options": {
        "reasoningEffort": "high",
        "cyberAccessProgram": "daybreakBlue"
      }
    }
  },
  "roles": {
    "intake": "fable",
    "spec-writer": "opus",
    "builder": "sol",
    "browser-tester": "terra",
    "approver": "opus"
  },
  "routing": {
    "low": {
      "code": "opus"
    },
    "medium": {
      "code": "opus"
    },
    "high": {
      "code": "opus"
    }
  },
  "surface_reviewers": {
    "ui": {
      "ux": "opus",
      "ui": "opus"
    },
    "security": {
      "security": "daybreak-blue"
    }
  },
  "escalate": {
    "categories": [
      "money, access or identity: payments, auth, permissions, or database and storage security rules",
      "deploy, CI or hosting config",
      "schema migration, email, production data, or new dependency",
      "product or business decision in a spec Assumption (pricing, public copy, free vs paid)",
      "changes to the factory itself (.claude/ or factory/)",
      "encryption or key handling (the crypto package, DEK wrapping, VAULT_MASTER_KEY, kekVersion)",
      "principal permissions or authorization (API key permissions or scope, requireScope, ownership checks, or 404-vs-403 rules)",
      "plaintext secret exposure (any path that returns plaintext values like reveal, inject, export, jv run, MCP tools, or could put a value into logs or audit events)",
      "audit log schema or what gets audited",
      "lint, format or TypeScript config (oxlint.config.ts, oxfmt.config.ts, tsconfig*.json) changes that loosen checks"
    ]
  },
  "protected_paths": [
    "factory/checks.sh",
    "factory/config.json"
  ],
  "ports": {
    "base": 5100,
    "step": 10
  },
  "browser": {
    "surfaces": [
      "ui"
    ],
    "computer_use": true,
    "chrome_app": "Google Chrome",
    "cli": "playwright-cli",
    "setup": "playwright-cli --help"
  },
  "review_account": {
    "email_env": "FACTORY_REVIEW_EMAIL",
    "password_env": "FACTORY_REVIEW_PASSWORD",
    "seed": "bun run db:seed-reviewer"
  },
  "env_files": [
    "apps/web/.env"
  ],
  "dashboard": {
    "port": 8000,
    "open": true
  },
  "prices_usd_per_mtok": {
    "claude-fable-5-2": {
      "input": 8.0,
      "output": 40.0,
      "cache_write_5m": 10.0,
      "cache_write_1h": 16.0,
      "cache_read": 0.2
    },
    "claude-fable-5-1": {
      "input": 10.0,
      "output": 50.0,
      "cache_write_5m": 12.5,
      "cache_write_1h": 20.0,
      "cache_read": 0.25
    },
    "claude-opus-5-5": {
      "input": 4.0,
      "output": 20.0,
      "cache_write_5m": 5.0,
      "cache_write_1h": 8.0,
      "cache_read": 0.2
    },
    "claude-sonnet-5-5": {
      "input": 2.0,
      "output": 10.0,
      "cache_write_5m": 2.5,
      "cache_write_1h": 4.0,
      "cache_read": 0.1
    },
    "claude-haiku-5-5": {
      "input": 0.1,
      "output": 0.5,
      "cache_write_5m": 0.125,
      "cache_write_1h": 0.2,
      "cache_read": 0.01
    },
    "gpt-6.1-sol": {
      "input": 2.0,
      "output": 10.0,
      "cache_read": 0.1,
      "cache_write_30m": 2.5
    },
    "gpt-6.1-terra": {
      "input": 1.0,
      "output": 5.0,
      "cache_read": 0.05,
      "cache_write_30m": 1.25
    },
    "gpt-daybreak-blue-latest": {
      "input": 4.0,
      "output": 20.0,
      "cache_read": 0.4,
      "cache_write_30m": 5.0
    }
  }
}
